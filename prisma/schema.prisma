generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Orgao {
  id        String   @id @default(cuid())
  nome      String
  sigla     String?
  cnpj      String?
  ativo     Boolean  @default(true)
  payload   Json?    @map("payload")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  despesas   Despesa[]
  licitacoes Licitacao[]
  contratos  Contrato[]
  servidores Servidor[]
}

model Receita {
  id                String   @id @default(cuid())
  idExternalRef     String?  @map("id_external_ref")
  payload           Json?    @map("payload")
  exercicio         Int
  mes               Int?
  codigoNatureza    String   @map("codigo_natureza")
  naturezaReceita   String   @map("natureza_receita")
  categoriaEconomica String  @map("categoria_economica")
  fonteRecurso      String?  @map("fonte_recurso")
  fonteRecursoNome  String?  @map("fonte_recurso_nome")
  valorPrevisto     Float    @map("valor_previsto")
  valorArrecadado   Float    @map("valor_arrecadado")
  createdAt         DateTime @default(now()) @map("created_date")
  updatedAt         DateTime @updatedAt @map("updated_date")

  @@map("receitas")
}

model Despesa {
  id                String   @id @default(cuid())
  idExternalRef     String?  @map("id_external_ref")
  payload           Json?    @map("payload")
  exercicio         Int
  numeroEmpenho     String   @map("numero_empenho")
  dataEmpenho       DateTime? @map("data_empenho")
  tipoMovimento     String   @default("Empenho") @map("tipo_movimento")
  credorNome        String?  @map("credor_nome")
  credorCpfCnpj     String?  @map("credor_cpf_cnpj")
  objeto            String?  @db.Text
  historico         String?  @db.Text
  orgaoId           String?  @map("orgao_id")
  orgaoNome         String?  @map("orgao_nome")
  elementoDespesa   String?  @map("elemento_despesa")
  elementoDespesaNome String? @map("elemento_despesa_nome")
  valorEmpenhado    Float?   @map("valor_empenhado")
  valorLiquidado    Float?   @map("valor_liquidado")
  valorPago         Float?   @map("valor_pago")
  createdAt         DateTime @default(now()) @map("created_date")
  updatedAt         DateTime @updatedAt @map("updated_date")

  orgao             Orgao?   @relation(fields: [orgaoId], references: [id])

  @@map("despesas")
}

model Licitacao {
  id                         String   @id @default(cuid())
  idExternalRef              String?  @map("id_external_ref")
  payload                    Json?    @map("payload")
  autoridade                 String?  @map("autoridade")
  numero                     String
  ano                        Int
  modalidade                 String
  regulamento                String?  @map("regulamento")
  criterioJulgamento         String?  @map("criterio_julgamento")
  objeto                     String   @db.Text
  objetoResumido             String?  @db.Text @map("objeto_resumido")
  status                     String   @default("planejamento")
  dataAbertura               DateTime? @map("data_abertura")
  valorEstimado              Float?   @map("valor_estimado")
  numeroProcesso             String?  @map("numero_processo")
  orgaoId                    String?  @map("orgao_id")
  orgaoNome                  String?  @map("orgao_nome")
  justificativa               String?  @db.Text
  linkPncp                   String?  @map("link_pncp")
  createdAt                  DateTime @default(now()) @map("created_date")
  updatedAt                  DateTime @updatedAt @map("updated_date")

  numeroEdital               String?  @map("numero_edital")
  numeroProcAdministrativo  String?  @map("numero_proc_administrativo")
  fundamentoLegal            String?  @map("fundamento_legal")
  anoReferencia              Int?     @map("ano_referencia")
  referenciaProcesso         String?  @map("referencia_processo")
  reeditacao                 Boolean  @default(false) @map("reeditacao")
  convenioTransfergov        String?  @map("convenio_transfergov")
  anoConvenio                 Int?     @map("ano_convenio")
  enviarTransfergov          Boolean  @default(false) @map("enviar_transfergov")
  tipoObjeto                 String?  @map("tipo_objeto")
  fonteOrcamentaria          String?  @map("fonte_orcamentaria")
  observacao                 String?  @map("observacao")
  tipoContrato               String?  @map("tipo_contrato")
  validadeMeses              Int?     @map("validade_meses")
  prazoPagamento             String?  @map("prazo_pagamento")

  orgao             Orgao?   @relation(fields: [orgaoId], references: [id])
  contratos         Contrato[]

  @@map("licitacoes")
}

model Contrato {
  id                String   @id @default(cuid())
  idExternalRef     String?  @map("id_external_ref")
  payload           Json?    @map("payload")
  numero            String
  ano               Int
  tipoContrato      String?  @map("tipo_contrato")
  objeto            String   @db.Text
  objetoResumido    String?  @db.Text @map("objeto_resumido")
  status            String   @default("vigente")
  dataInicioVigencia DateTime @map("data_inicio_vigencia")
  dataFimVigencia   DateTime? @map("data_fim_vigencia")
  valorInicial      Float    @map("valor_inicial")
  valorAtual        Float?   @map("valor_atual")
  valorPago         Float?   @map("valor_pago")
  contratadoNome    String   @map("contratado_nome")
  contratadoCnpj    String   @map("contratado_cnpj")
  orgaoId           String?  @map("orgao_id")
  orgaoNome         String?  @map("orgao_nome")
  licitacaoId       String?  @map("licitacao_id")
  licitacaoNumero   String?  @map("licitacao_numero")
  gestorNome        String?  @map("gestor_nome")
  gestorCargo       String?  @map("gestor_cargo")
  fiscalNome        String?  @map("fiscal_nome")
  fiscalCargo       String?  @map("fiscal_cargo")
  linkPncp          String?  @map("link_pncp")
  createdAt         DateTime @default(now()) @map("created_date")
  updatedAt         DateTime @updatedAt @map("updated_date")

  orgao             Orgao?   @relation(fields: [orgaoId], references: [id])
  licitacao         Licitacao? @relation(fields: [licitacaoId], references: [id])

  @@map("contratos")
}

model Servidor {
  id                String   @id @default(cuid())
  idExternalRef     String?  @map("id_external_ref")
  payload           Json?    @map("payload")
  nome              String
  matricula         String
  cargo             String
  funcao            String?
  orgaoId           String?  @map("orgao_id")
  orgaoNome         String?  @map("orgao_nome")
  lotacao           String?
  vinculo           String   @default("efetivo")
  cargaHoraria      Int?     @map("carga_horaria")
  dataAdmissao      DateTime? @map("data_admissao")
  anoReferencia     Int?     @map("ano_referencia")
  mesReferencia     Int?     @map("mes_referencia")
  remuneracaoBase   Float?   @map("remuneracao_base")
  gratificacoes     Float?   @default(0)
  adicionais        Float?   @default(0)
  indenizacoes      Float?   @default(0)
  remuneracaoBruta  Float?   @map("remuneracao_bruta")
  impostoRenda      Float?   @map("imposto_renda")
  previdencia       Float?   @default(0)
  outrosDescontos   Float?   @map("outros_descontos")
  remuneracaoLiquida Float? @map("remuneracao_liquida")
  createdAt         DateTime @default(now()) @map("created_date")
  updatedAt         DateTime @updatedAt @map("updated_date")

  orgao             Orgao?   @relation(fields: [orgaoId], references: [id])

  @@map("servidores")
}

model Convenio {
  id                String   @id @default(cuid())
  idExternalRef     String?  @map("id_external_ref")
  numero            String
  ano               Int
  tipo              String
  objeto            String   @db.Text
  objetoResumido    String?  @db.Text @map("objeto_resumido")
  status            String   @default("em_execucao")
  concedente        String
  concedenteCnpj    String?  @map("concedente_cnpj")
  convenente        String?
  dataInicioVigencia DateTime @map("data_inicio_vigencia")
  dataFimVigencia   DateTime? @map("data_fim_vigencia")
  valorTotal        Float    @map("valor_total")
  valorRepasse      Float?   @map("valor_repasse")
  valorContrapartida Float?  @map("valor_contrapartida")
  valorExecutado    Float?   @map("valor_executado")
  numeroProcesso    String?  @map("numero_processo")
  linkPlataforma    String?  @map("link_plataforma")
  createdAt         DateTime @default(now()) @map("created_date")
  updatedAt         DateTime @updatedAt @map("updated_date")

  @@map("convenios")
}

model SolicitacaoSIC {
  id                  String   @id @default(cuid())
  protocolo           String   @unique
  payload             Json?    @map("payload")
  ano                 Int
  tipo                String   @default("acesso_informacao")
  canalEntrada        String   @map("canal_entrada")
  solicitanteNome     String   @map("solicitante_nome")
  solicitanteEmail    String   @map("solicitante_email")
  solicitanteTelefone String?  @map("solicitante_telefone")
  solicitanteTipo     String?  @map("solicitante_tipo")
  orgaoDestinatarioId String? @map("orgao_destinatario_id")
  orgaoDestinatarioNome String? @map("orgao_destinatario_nome")
  assunto             String
  descricao           String
  dataRegistro       DateTime @default(now()) @map("data_registro")
  dataPrazo          DateTime? @map("data_prazo")
  dataResposta       DateTime? @map("data_resposta")
  resposta            String?
  status              String   @default("aberto")
  historico           String?
  createdAt           DateTime @default(now()) @map("created_date")
  updatedAt           DateTime @updatedAt @map("updated_date")

  @@map("solicitacoes_sic")
}

model Dataset {
  id                  String   @id @default(cuid())
  nome                String
  slug                String   @unique
  descricao           String
  categoria            String
  periodicidade        String
  ultimaAtualizacao    DateTime @map("ultima_atualizacao")
  formatosDisponiveis  String?  @map("formatos_disponiveis")
  totalRegistros      Int?     @map("total_registros")
  dicionarioDados     String?  @map("dicionario_dados")
  ativo               Boolean  @default(true)
  payload             Json?    @map("payload")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("datasets")
}

model ConfiguracaoSite {
  id          String   @id @default(cuid())
  chave       String   @unique @map("chave")
  valor       String   @db.Text @map("valor")
  tipo        String?  @map("tipo")
  descricao   String?  @map("descricao")
  ordem       Int?     @map("ordem")
  payload     Json?    @map("payload")
  createdAt   DateTime @default(now()) @map("created_date")
  updatedAt   DateTime @updatedAt @map("updated_date")

  @@map("configuracao_site")
}

model Anexo {
  id            String   @id @default(cuid())
  nomeArquivo   String   @map("nome_arquivo")
  urlArquivo    String   @map("url_arquivo")
  tamanho       Int?     @map("tamanho")
  tipoMime      String?  @map("tipo_mime")
  entidadeTipo  String   @map("entidade_tipo")
  entidadeId    String   @map("entidade_id")
  payload       Json?    @map("payload")
  createdAt     DateTime @default(now()) @map("created_date")

  @@map("anexos")
}

/// Configuracao unica do sistema de backup (registro singleton, id = "singleton").
model BackupConfig {
  id              String  @id @default("singleton")
  incluirBanco    Boolean @default(true) @map("incluir_banco")
  incluirMidias   Boolean @default(true) @map("incluir_midias")
  pularDuplicados Boolean @default(true) @map("pular_duplicados")

  // Agendamento local. modo: INTERVALO | DIARIO | SEMANAL
  localAtivo          Boolean @default(false) @map("local_ativo")
  localModo           String  @default("DIARIO") @map("local_modo")
  localIntervaloHoras Int     @default(24) @map("local_intervalo_horas")
  localHorarios       String  @default("03:00") @map("local_horarios")
  localDiasSemana     String  @default("1") @map("local_dias_semana")
  localRetencaoQtd    Int     @default(7) @map("local_retencao_qtd")
  localRetencaoDias   Int     @default(0) @map("local_retencao_dias")

  // Agendamento em nuvem (Google Drive)
  nuvemAtivo          Boolean @default(false) @map("nuvem_ativo")
  nuvemModo           String  @default("DIARIO") @map("nuvem_modo")
  nuvemIntervaloHoras Int     @default(24) @map("nuvem_intervalo_horas")
  nuvemHorarios       String  @default("04:00") @map("nuvem_horarios")
  nuvemDiasSemana     String  @default("1") @map("nuvem_dias_semana")
  nuvemRetencaoQtd    Int     @default(14) @map("nuvem_retencao_qtd")
  nuvemRetencaoDias   Int     @default(0) @map("nuvem_retencao_dias")

  driveFolderId   String? @map("drive_folder_id")
  driveFolderNome String? @map("drive_folder_nome")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  @@map("backup_config")
}

/// Conexao com o Google Drive obtida via broker do BackupHub.
model BackupDriveConta {
  id            String    @id @default(cuid())
  email         String
  googleSub     String?   @map("google_sub")
  escopo        String?
  tokenCifrado  String    @db.Text @map("token_cifrado")
  quotaTotal    String?   @map("quota_total")
  quotaUsada    String?   @map("quota_usada")
  conectadoEm   DateTime  @default(now()) @map("conectado_em")
  ultimoUsoEm   DateTime? @map("ultimo_uso_em")
  revogadoEm    DateTime? @map("revogado_em")
  ultimoErro    String?   @db.Text @map("ultimo_erro")

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  @@index([revogadoEm])
  @@map("backup_drive_contas")
}

/// Historico de execucoes de backup.
model BackupJob {
  id            String    @id @default(cuid())
  tipo          String    @default("LOCAL")
  origem        String    @default("MANUAL")
  escopo        String    @default("COMPLETO")
  status        String    @default("EXECUTANDO")
  arquivo       String?
  tamanhoBytes  BigInt?   @map("tamanho_bytes")
  sha256        String?   @db.VarChar(64)
  contentHash   String?   @map("content_hash") @db.VarChar(64)
  caminhoLocal  String?   @db.Text @map("caminho_local")
  driveFileId   String?   @map("drive_file_id")
  driveFolderId String?   @map("drive_folder_id")
  duplicadoDeId String?   @map("duplicado_de_id")
  totalTabelas  Int?      @map("total_tabelas")
  totalRegistros Int?     @map("total_registros")
  totalArquivos Int?      @map("total_arquivos")
  iniciadoEm    DateTime  @default(now()) @map("iniciado_em")
  finalizadoEm  DateTime? @map("finalizado_em")
  duracaoMs     Int?      @map("duracao_ms")
  erro          String?   @db.Text
  log           String?   @db.Text

  createdAt DateTime @default(now()) @map("created_date")
  updatedAt DateTime @updatedAt @map("updated_date")

  @@index([tipo, status, iniciadoEm])
  @@index([contentHash])
  @@map("backup_jobs")
}
