# Banco de dados (MariaDB/MySQL)
DATABASE_URL="mysql://usuario:senha@host:3306/banco"

# NextAuth / assinatura de sessão
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Token Bearer da API pública (gere um novo em produção)
API_BEARER_TOKEN=""

# URL pública do site (usada no return_url da conexão com o Google Drive)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---- Sistema de backup (painel /admin/backup) ----
# Senha do painel administrativo. Sem ela, o painel responde 503.
ADMIN_PASSWORD=""

# Opcionais (veja docs/backup.md):
# ADMIN_SESSION_SECRET=""            # assina o cookie de sessão (padrão: NEXTAUTH_SECRET)
# BACKUP_DIR="/home/tefe-portaltransparencia/backups"   # fora do repositório em produção
# BACKUP_ENCRYPTION_KEY=""           # cifra o token do Drive (padrão: NEXTAUTH_SECRET)
# BACKUPHUB_BASE_URL="https://backup.marreira.link"
# BACKUP_SCHEDULER_ENABLED=true      # padrão: ligado em produção, desligado em dev
# BACKUP_MEDIA_DIRS="public/uploads"
# BACKUP_DATABASE_URL=""             # conexão só-leitura dedicada ao dump
# BACKUP_TIMEZONE="America/Manaus"
